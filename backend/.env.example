
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
# Optional alternative to the three values above. Relative paths are resolved
# from the backend process working directory.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
